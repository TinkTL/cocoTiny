# Alipay Open Platform application settings. Keep all of these server-only.
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
ALIPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Use PKCS8 when the private key begins with "BEGIN PRIVATE KEY".
ALIPAY_PRIVATE_KEY_TYPE=PKCS8

# Sandbox: https://openapi-sandbox.dl.alipaydev.com/gateway.do
# Production: https://openapi.alipay.com/gateway.do
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# Alipay must be able to POST to this public HTTPS URL.
ALIPAY_NOTIFY_URL=https://your-domain.example/api/payments/alipay/notify
ALIPAY_RETURN_URL=https://your-domain.example/payment/result

# Optional but recommended for an additional callback identity check.
ALIPAY_SELLER_ID=

# Persistent paid orders (Vercel Marketplace / Neon).
DATABASE_URL=

# Transactional delivery email. Keep the API key server-only.
RESEND_API_KEY=
EMAIL_FROM="CocoTiny <gift@cocotiny.com>"
SITE_URL=https://www.cocotiny.com

# Tencent COS private bucket. Use a read-only CAM sub-user restricted to this bucket.
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_BUCKET=cocotiny-asset-1365840561
TENCENT_COS_REGION=ap-guangzhou
